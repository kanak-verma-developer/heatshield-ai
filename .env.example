# Copy to .env and fill in what you need. Everything is optional.

# --- AI recommendations. Without any key the rule-based engine is used.
# Gemini (get a key at https://aistudio.google.com/apikey):
GEMINI_API_KEY=
# Model name; change it if Google retires/renames the default (gemini-2.5-flash):
# GEMINI_MODEL=gemini-2.5-flash
# Or Claude instead:
ANTHROPIC_API_KEY=
# Only needed if BOTH keys are set (default: gemini). Values: gemini | claude | none
# HEATSHIELD_LLM_PROVIDER=gemini

# --- API hardening
# Comma-separated browser origins allowed to call the API cross-origin.
# (Not needed when the dashboard is served by the backend itself at "/".)
# ALLOWED_ORIGINS=https://your-dashboard.example.com
# Per-IP requests per minute for /api/* (0 disables). Default 240.
# HEATSHIELD_RATE_LIMIT_PER_MIN=240
# Max simultaneous WebSocket clients. Default 50.
# HEATSHIELD_MAX_WS=50
# If set, POST /api/predict requires header  X-API-Key: <this value>
# HEATSHIELD_API_KEY=
# Seconds a zone's recommendation is cached (bounds paid LLM calls). Default 600.
# HEATSHIELD_REC_TTL=600

# --- Security
# Bind address. 127.0.0.1 = this computer only (safe default). Use 0.0.0.0 only behind HTTPS / a firewall.
# HEATSHIELD_HOST=127.0.0.1
# Max live-feed connections per visitor. Default 5.
# HEATSHIELD_MAX_WS_PER_IP=5
# Show /docs and /openapi.json (development only). Default: hidden.
# HEATSHIELD_ENABLE_DOCS=1
# Dashboard opened as a file:// page needs ALLOWED_ORIGINS to include "null" (not recommended).

# --- Behaviour
# Seconds between stored history points (whole city at once). Default 60.
# HEATSHIELD_HISTORY_INTERVAL=60
# DEMO mode only: how much faster than real time the simulated day runs. Default 60.
# HEATSHIELD_SIM_SPEEDUP=60

# --- Future real-data integrations (not wired in yet, see docs/DATA_SOURCES.md)
NASA_POWER_API_KEY=
GOOGLE_EARTH_ENGINE_SERVICE_ACCOUNT_JSON=
IMD_API_KEY=
